      "expect": "{\n  \"stage\": \"kit_lookup_failed\",\n  \"rack_result\": {\n    \"loaded\": true\n  },\n  \"error\": \"Path part 'missing' not found\",\n  \"partial_completion\": true,\n  \"whole_workflow_retry_safe\": false,\n  \"kit_load_attempted\": false,\n  \"reconciliation_required\": false,\n  \"failure_phase\": \"read_only_lookup\"\n}",
