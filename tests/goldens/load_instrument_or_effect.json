{
  "cases": [
    {
      "args": {
        "track_index": 0,
        "uri": "query:Synths#Operator"
      },
      "expect": "Loaded instrument with URI 'query:Synths#Operator' on track 0. New devices: Operator",
      "name": "success_new_devices",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "query:Synths#Operator",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "loaded": true,
            "new_devices": [
              "Operator"
            ]
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "query:Synths#Operator"
      },
      "expect": "Loaded instrument with URI 'query:Synths#Operator' on track 0. Devices on track: Operator, Reverb",
      "name": "success_no_new_devices",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "query:Synths#Operator",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "devices_after": [
              "Operator",
              "Reverb"
            ],
            "loaded": true,
            "new_devices": []
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "query:Drums#FileId_5483"
      },
      "expect": "Loaded '808 Core Kit.adg' on track 0",
      "name": "loaded_no_device_report",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "query:Drums#FileId_5483",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "item_name": "808 Core Kit.adg",
            "loaded": true,
            "track_name": "Kick"
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "query:Synths#Operator"
      },
      "expect": "Failed to load instrument with URI 'query:Synths#Operator'",
      "name": "not_loaded",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "query:Synths#Operator",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "loaded": false
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "fixture"
      },
      "expect": "{\n  \"async_completion\": \"unverified\",\n  \"changed_state\": [],\n  \"devices_after\": [\n    \"Device\"\n  ],\n  \"item_name\": \"Device\",\n  \"load_state_token\": \"1\",\n  \"loaded\": true,\n  \"new_devices\": [\n    \"Device\"\n  ],\n  \"reconciliation_required\": false,\n  \"state_preservation\": \"unchanged_at_return\",\n  \"state_scope\": \"immediate_main_thread_return\",\n  \"topology_changed\": false,\n  \"track_name\": \"Track\"\n}",
      "name": "state_unchanged",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "fixture",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "async_completion": "unverified",
            "changed_state": [],
            "devices_after": [
              "Device"
            ],
            "item_name": "Device",
            "load_state_token": "1",
            "loaded": true,
            "new_devices": [
              "Device"
            ],
            "reconciliation_required": false,
            "state_preservation": "unchanged_at_return",
            "state_scope": "immediate_main_thread_return",
            "topology_changed": false,
            "track_name": "Track"
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "fixture"
      },
      "expect": "{\n  \"async_completion\": \"unverified\",\n  \"changed_state\": [\n    {\n      \"after\": {\n        \"arm\": true,\n        \"monitoring\": 0\n      },\n      \"before\": {\n        \"arm\": false,\n        \"monitoring\": 1\n      },\n      \"identity\": 12\n    }\n  ],\n  \"devices_after\": [\n    \"Device\"\n  ],\n  \"item_name\": \"Device\",\n  \"loaded\": true,\n  \"new_devices\": [\n    \"Device\"\n  ],\n  \"reason\": \"Unattributed arm/monitor/identity change; no compensating writes performed\",\n  \"reconciliation_required\": true,\n  \"retry_safe\": false,\n  \"state_preservation\": \"unresolved\",\n  \"state_scope\": \"immediate_main_thread_return\",\n  \"topology_changed\": false,\n  \"track_name\": \"Track\"\n}",
      "name": "state_reconciliation",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "fixture",
            "track_index": 0,
            "track_type": "regular"
          },
          "response": {
            "async_completion": "unverified",
            "changed_state": [
              {
                "after": {
                  "arm": true,
                  "monitoring": 0
                },
                "before": {
                  "arm": false,
                  "monitoring": 1
                },
                "identity": 12
              }
            ],
            "devices_after": [
              "Device"
            ],
            "item_name": "Device",
            "loaded": true,
            "new_devices": [
              "Device"
            ],
            "reason": "Unattributed arm/monitor/identity change; no compensating writes performed",
            "reconciliation_required": true,
            "retry_safe": false,
            "state_preservation": "unresolved",
            "state_scope": "immediate_main_thread_return",
            "topology_changed": false,
            "track_name": "Track"
          }
        }
      ]
    },
    {
      "args": {
        "track_index": 0,
        "uri": "query:Synths#Operator"
      },
      "expect": "Error loading instrument by URI: boom",
      "name": "error",
      "wire": [
        {
          "command": "load_browser_item",
          "params": {
            "item_uri": "query:Synths#Operator",
            "track_index": 0,
            "track_type": "regular"
          },
          "raise": "boom"
        }
      ]
    }
  ]
}
