{
  "cases": [
    {
      "args": {
        "chain_index": 1,
        "device_index": 0,
        "device_name": "Utility",
        "track_index": 1
      },
      "expect": "Inserted into 'Audio Effect Rack' chain 1 'Amp B' (volume 0.0 dB; Utility)",
      "name": "success",
      "wire": [
        {
          "command": "insert_chain_device",
          "params": {
            "chain_index": 1,
            "device_index": 0,
            "device_name": "Utility",
            "index": -1,
            "track_index": 1,
            "track_type": "regular"
          },
          "response": {
            "chain": {
              "devices": [
                {
                  "index": 0,
                  "name": "Utility"
                }
              ],
              "index": 1,
              "name": "Amp B",
              "volume": 0.85,
              "volume_display": "0.0 dB"
            },
            "chain_index": 1,
            "device_index": 0,
            "device_name": "Audio Effect Rack",
            "track_index": 1,
            "track_name": "GTR"
          }
        }
      ]
    },
    {
      "args": {
        "chain_index": 1,
        "device_index": 0,
        "device_name": "Utility",
        "track_index": 1
      },
      "expect": "Error inserting a device into the chain: boom",
      "name": "error",
      "wire": [
        {
          "command": "insert_chain_device",
          "params": {
            "chain_index": 1,
            "device_index": 0,
            "device_name": "Utility",
            "index": -1,
            "track_index": 1,
            "track_type": "regular"
          },
          "raise": "boom"
        }
      ]
    }
  ]
}
