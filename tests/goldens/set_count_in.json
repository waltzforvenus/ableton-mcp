{
  "cases": [
    {
      "args": {
        "bars": 2,
        "metronome": true
      },
      "expect": "Count-in set to 2 Bars; metronome on",
      "name": "success_metronome_on",
      "wire": [
        {
          "command": "set_count_in",
          "params": {
            "bars": 2,
            "metronome": true
          },
          "response": {
            "count_in": "2 Bars",
            "metronome": true
          }
        }
      ]
    },
    {
      "args": {
        "bars": 0,
        "metronome": false
      },
      "expect": "Count-in set to None; metronome off",
      "name": "success_metronome_off",
      "wire": [
        {
          "command": "set_count_in",
          "params": {
            "bars": 0,
            "metronome": false
          },
          "response": {
            "count_in": "None",
            "metronome": false
          }
        }
      ]
    },
    {
      "args": {
        "bars": 2,
        "metronome": true
      },
      "expect": "Live's API exposes count-in as read-only on this build, so it is still 1 Bar \u2014 set it in Live's UI (Record button context menu). Applied the rest: metronome on",
      "name": "read_only_partial",
      "wire": [
        {
          "command": "set_count_in",
          "params": {
            "bars": 2,
            "metronome": true
          },
          "response": {
            "count_in": "1 Bar",
            "count_in_duration": 1,
            "count_in_writable": false,
            "metronome": true,
            "requested": "2 Bars"
          }
        }
      ]
    },
    {
      "args": {
        "bars": 2,
        "metronome": true
      },
      "expect": "Error setting count-in: boom",
      "name": "error",
      "wire": [
        {
          "command": "set_count_in",
          "params": {
            "bars": 2,
            "metronome": true
          },
          "raise": "boom"
        }
      ]
    }
  ]
}
