{
  "cases": [
    {
      "args": {
        "name": "Chorus"
      },
      "expect": "Jumped to locator 'Chorus' at beat 16.0 \u2014 the transport was stopped, so the start marker is planted there: play and record now launch from that beat",
      "name": "success",
      "wire": [
        {
          "command": "jump_to_locator",
