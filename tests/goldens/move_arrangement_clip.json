{
  "cases": [
    {
      "args": {
        "clip_index": 0,
        "destination_time": 32.0,
        "track_index": 0
      },
      "expect": "Moved arrangement clip 'Vox Take' \u2014 it now spans beats 32.0 to 40.0 on track 0. Clip indices on this track have shifted (start-time order); re-read get_arrangement_clips before the next arrangement edit",
      "name": "success",
      "wire": [
        {
          "command": "move_arrangement_clip",
          "params": {
            "clip_index": 0,
            "destination_time": 32.0,
            "track_index": 0
          },
          "response": {
            "clip_name": "Vox Take",
            "end_time": 40.0,
            "moved": true,
            "start_time": 32.0
          }
        }
      ]
    },
    {
      "args": {
        "clip_index": 0,
        "destination_time": 32.0,
        "track_index": 0
      },
      "expect": "Error moving arrangement clip: boom",
      "name": "error",
      "wire": [
        {
          "command": "move_arrangement_clip",
          "params": {
            "clip_index": 0,
            "destination_time": 32.0,
            "track_index": 0
          },
          "raise": "boom"
        }
      ]
    }
  ]
}
